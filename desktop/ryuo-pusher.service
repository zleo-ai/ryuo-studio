[Unit]
Description=龙屏推送：心跳、额度面板、屏上原生程序保活
After=graphical-session.target

[Service]
WorkingDirectory=@ROOT@
ExecStart=/usr/bin/python3 -I @ROOT@/tools/pusher.py
Restart=always
RestartSec=10
StandardOutput=append:%h/.local/share/ryuo-studio/pusher.log
StandardError=append:%h/.local/share/ryuo-studio/pusher.log

[Install]
WantedBy=default.target
